{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "0.78.1",
  "default_locale": "en",
  "key": "",
  "icons": {
    "128": "icons/128.png",
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png"
  },
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "sites.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "__MSG_name__",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/128.png",
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.bilibili.com/*",
        "*://*.vimeo.com/*",
        "*://*.ted.com/*",
        "*://*.nicovideo.jp/*",
        "*://*.dailymotion.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kando@yldm.ai",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
