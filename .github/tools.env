# The sources of the ffmpeg and whisper-cli that Kando downloads on its first launch (packages/media/toolkit.go), which the Tools workflow builds and publishes as the assets of the release TOOLS_RELEASE. Changing what it builds needs a new TOOLS_RELEASE: a release that exists is never rebuilt, so the checksums Kando pins keep matching what it downloads.
TOOLS_RELEASE=tools-1

# ffmpeg for macOS, built from its release with SDL2 (for ffplay, which plays the sound) and dav1d (AV1) linked in.
FFMPEG_VERSION=9.0.2
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
SDL2_VERSION=2.32.10
SDL2_SHA256=5f5993c530f084535c65a6879e9b26ad441169b3e25d789d83287040a9ca5165
DAV1D_VERSION=1.5.4
DAV1D_SHA256=686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5

# ffmpeg for Linux, the static LGPL build of BtbN/FFmpeg-Builds, whose dated releases are pruned after a while, hence republished here.
BTBN_RELEASE=autobuild-2026-11-08-12-35
BTBN_BUILD=ffmpeg-n9.0.2-48-gd4070a14ce
BTBN_LINUX_AMD64_SHA256=887b89480085387038e1107fd3a43ed4a5f9ceabf2ddf7c62d9aa3b30e47f393
BTBN_LINUX_ARM64_SHA256=4ac9a3f37ae8993ff32aed8acf3ee8c434ce57ed2f22a2bddca5e68948f4a870

# whisper-cli, built from the whisper.cpp release: with Metal on macOS, and on Linux with a CPU backend for each processor generation, the best of which it picks as it starts.
WHISPER_VERSION=1.9.5
WHISPER_SHA256=ff1a9053feb509ff9d7729703355541ae9690073a6b1c40eb692c962e0dc1720
